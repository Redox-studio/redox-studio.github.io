---
import "../styles/global.css";
import "../styles/qianli-tokens.css";
import "../styles/qianli.css";
import SEO from "../components/SEO.astro";
interface Props {
  title?: string;
  description?: string;
  document?: boolean;
  image?: string;
  canonical?: string | URL;
  noindex?: boolean;
}
const {
  title = "潜历 — 什么时候，去哪潜？",
  description = "什么时候，去哪潜？潜历把季节、签证、交通和行程放在一起，帮你决定下一次去哪。为 iPhone 设计的潜水目的地工具。",
  document = false,
  image = "/assets/og/qianli-og.jpg",
  canonical = Astro.url.pathname,
  noindex = false,
} = Astro.props;
const structuredData = document ? undefined : {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "潜历",
  alternateName: "Qianli",
  applicationCategory: "TravelApplication",
  operatingSystem: "iOS 26 or later",
  description,
  url: new URL(canonical, Astro.site).href,
};
---
<!doctype html>
<html lang="zh-CN" class:list={["qianli-theme", "qianli-colors", { "q-document-theme": document }]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#061216" />
    <SEO {title} {description} {image} {canonical} {noindex} {structuredData} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳至主要内容</a>
    <header class="q-nav q-wrap">
      <a class="wordmark" href="/" aria-label="返回 Redox Studio 首页">REDOX STUDIO</a>
      <nav aria-label="主导航"><a href="/#work">作品</a><a href="/about/">关于</a></nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="q-footer q-wrap">
      <a class="wordmark" href="/">REDOX STUDIO</a>
      <p>© 2026 Redox Studio</p>
      <a href="/">返回工作室 <span aria-hidden="true">↗</span></a>
    </footer>
  </body>
</html>
