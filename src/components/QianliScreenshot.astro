---
import QianliImage from "./QianliImage.astro";
interface Props {
  name: string;
  alt: string;
  caption: string;
  number: string;
}
const { name, alt, caption, number } = Astro.props;
---
<figure class="q-screen">
  <QianliImage {name} {alt} />
  <figcaption><span>{number}</span>{caption}</figcaption>
</figure>
