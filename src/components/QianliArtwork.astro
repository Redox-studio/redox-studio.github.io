---
import "../styles/qianli-tokens.css";
import QianliImage from "./QianliImage.astro";
---
<div class="qianli-artwork qianli-colors">
  <div class="artwork-caption" aria-hidden="true">
    <span>QIANLI</span><span class="artwork-name">潜历</span><span>月份 × 季节<br />签证 × 交通</span>
  </div>
  <QianliImage name="calendar-home" alt="潜历月历首页：按月份与季节分组浏览潜水目的地" sizes="(max-width: 430px) 63vw, 290px" />
</div>
<style>
  .qianli-artwork { display: flex; align-items: center; justify-content: space-evenly; gap: 20px; height: clamp(330px, 36vw, 500px); overflow: hidden; padding: 32px; color: var(--q-foreground); background: linear-gradient(155deg, var(--q-background-top), var(--q-background)); border: 1px solid var(--q-border); }
  .artwork-caption { display: flex; flex-direction: column; gap: 24px; flex-shrink: 0; font-size: 11px; line-height: 1.9; letter-spacing: 0.12em; color: var(--q-muted); }
  .artwork-name { font: 48px ui-serif, "Songti SC", STSong, serif; color: var(--q-foreground); letter-spacing: 0.08em; }
  .qianli-artwork :global(img) { display: block; width: min(56%, 290px); height: auto; flex-shrink: 0; align-self: flex-start; margin-top: 10px; border: 1px solid var(--q-border); border-radius: 24px; box-shadow: 0 12px 32px rgb(0 0 0 / 12%); }
  @media (min-width: 701px) and (max-width: 1024px) {
    .qianli-artwork { padding: 24px 18px; gap: 12px; }
    .artwork-name { font-size: 36px; }
    .artwork-caption { font-size: 10px; }
  }
  @media (max-width: 430px) {
    .qianli-artwork { height: 360px; padding: 24px 16px; gap: 12px; }
    .artwork-name { font-size: 36px; }
    .qianli-artwork :global(img) { width: 63%; border-radius: 20px; }
    .artwork-caption { font-size: 9px; gap: 20px; }
  }
</style>
