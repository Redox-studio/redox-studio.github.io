---
import BaseLayout from "../layouts/BaseLayout.astro";
import Placeholder from "../components/Placeholder.astro";
import { products } from "../data/products";
---

<BaseLayout
  title="Redox Studio"
  description="做我们自己想用的 App，也做我们自己想玩的游戏。这里放着我们两个人真正做出来，并且愿意继续做下去的东西。"
>
  <section class="home-hero" aria-labelledby="home-title">
    <p class="eyebrow">Independent studio</p>
    <h1 id="home-title">
      REDOX
      <br />
      STUDIO<span class="title-dot">.</span>
    </h1>
    <div class="hero-bottom">
      <p>
        做我们自己想用的 App，
        <br />
        也做我们自己想玩的游戏。
      </p>
      <a class="text-link" href="#work">
        查看作品 <span aria-hidden="true">↙</span>
      </a>
    </div>
  </section>
  <section id="work" class="section work-section" aria-labelledby="work-title">
    <div class="section-heading">
      <h2 id="work-title">作品</h2>
      <span class="eyebrow">01 / Work</span>
    </div>
    {products.map((product, index) => (
      <article class="work-card">
        <a
          class="work-art"
          href={product.href}
          aria-label={`了解${product.name}`}
        >
          <Placeholder label="产品视觉占位" detail="产品素材待提供" />
        </a>
        <div class="work-info">
          <p class="eyebrow">
            {String(index + 1).padStart(2, "0")} / {product.category}
          </p>
          <h3>
            <a href={product.href}>{product.name}</a>
          </h3>
          <p class="muted">{product.description}</p>
          <a class="text-link" href={product.href}>
            了解{product.name} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    ))}
  </section>
  <section class="studio-note">
    <p class="studio-statement">Redox Studio 是我们两个人一起做东西时用的名字。</p>
    <p class="studio-description">
      有时候是 App，有时候是游戏。这里会放我们真正做出来，并且愿意继续做下去的东西。
    </p>
    <a class="text-link" href="/about/">
      关于 Redox Studio <span aria-hidden="true">→</span>
    </a>
  </section>
</BaseLayout>
