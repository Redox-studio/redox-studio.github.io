---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Placeholder from "../../components/Placeholder.astro";
---

<BaseLayout
  title="潜历 — Redox Studio"
  description="潜历，Redox Studio 的作品。产品介绍与素材正在整理中。"
>
  <header class="page-intro product-hero">
    <div>
      <p class="eyebrow">Redox Studio / App</p>
      <h1>潜历</h1>
      <p class="lead muted">TODO · 产品简介待提供。</p>
      <div class="cta-placeholder">
        <button disabled>App Store · 待提供</button>
        <p class="small muted">TODO · 确认商店链接与上架状态。</p>
      </div>
    </div>
    <Placeholder kind="icon" label="App icon 占位" detail="正式图标待提供" />
  </header>
  <section class="section" aria-labelledby="screenshots-title">
    <div class="section-heading">
      <h2 id="screenshots-title">产品画面</h2>
      <span class="eyebrow">01 / Screenshots</span>
    </div>
    <Placeholder
      kind="screenshot"
      label="Screenshot 区域占位"
      detail="真实截图、展示顺序及图片说明待提供"
    />
  </section>
  <section class="section" aria-labelledby="features-title">
    <div class="section-heading">
      <h2 id="features-title">产品特点</h2>
      <span class="eyebrow">02 / Features</span>
    </div>
    <div class="feature-placeholder">
      <span class="eyebrow">TODO</span>
      <p>待提供已确认的功能标题、说明与对应素材。</p>
    </div>
  </section>
  <section class="section product-links" aria-labelledby="info-title">
    <h2 id="info-title">进一步了解</h2>
    <a class="text-link" href="/qianli/privacy/">
      Privacy Policy <span aria-hidden="true">↗</span>
    </a>
    <a class="text-link" href="/qianli/support/">
      Support <span aria-hidden="true">↗</span>
    </a>
  </section>
</BaseLayout>
